{
  "name": "veil-social-api",
  "version": "2.0.0",
  "private": true,
  "description": "Social Space API for Cloudflare Workers (D1 database, R2 media).",
  "type": "module",
  "main": "src/worker.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "generate": "prisma generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "seed": "node prisma/seed.js",
    "build": "prisma generate",
    "test": "node ../scripts/run-tests.mjs",
    "typecheck": "node --check src/worker.js"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "bip39": "^3.1.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/adapter-libsql": "^7.10.1",
    "prisma": "^7.10.1",
    "wrangler": "^4.158.0"
  }
}
