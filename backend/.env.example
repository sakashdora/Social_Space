# Development defaults. Never commit backend/.env or put these secrets in VITE_*.
NODE_ENV=development
PORT=3000

# Copy the exact connection strings from Supabase Connect, or use local PostgreSQL.
# Runtime: transaction pooler (6543), pgbouncer=true, small per-instance pool.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=2
# Migrations: direct DB (db.PROJECT_REF.supabase.co:5432) or session pooler (5432).
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Required independent secrets: generate each with node:crypto randomBytes.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_64_RANDOM_HEX_CHARACTERS
RECOVERY_CODE_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Vercel sends Authorization: Bearer CRON_SECRET to the scheduled endpoint.
CRON_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=veil-media

# Optional realtime. Both are needed; see DEPLOYMENT.md and backend/supabase/realtime.sql.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Exact origins only. Production values must match the deployed FRONTEND.
FRONTEND_ORIGIN=http://localhost:5173
WEBAUTHN_RP_NAME=Social Space
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
TOTP_ISSUER=Social Space

# Optional; PostgreSQL stores authentication challenges when Redis is absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional AI providers. A gsk_ key uses Groq; an xAI key uses xAI.
GROK_API_KEY=
AI_API_KEY=
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1/chat/completions
AI_MODEL=gemini-2.5-flash

# Comma-separated existing account handles authorized to review reports/appeals.
MODERATOR_HANDLES=
