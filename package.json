{
  "name": "veil-social",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "install:all": "npm ci",
    "test": "npm run test:crypto && npm test --workspace backend",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "build": "npm --prefix backend run build && npm --prefix frontend run build && node scripts/copy-build.js",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "start:backend": "npm --prefix backend run start",
    "start:frontend": "npm --prefix frontend run start",
    "vercel-build": "node scripts/vercel-build.js",
    "prisma:generate": "npm --prefix backend run build",
    "test:crypto": "node --experimental-strip-types --test scripts/test-crypto.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "fake-indexeddb": "^6.2.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.16"
  }
}
